{
  "name": "task3",
  "version": "1.0.0",
  "engine": "7.10.0",
  "description": "Nodejs, react and webpack boilerplate for simple and quick install",
  "scripts": {
    "start": "node dist/server/index.js",
    "dev:win": "set NODE_ENV=development && nodemon src/server/index.js --ignore src/client --exec babel-node",
    "dev": "NODE_ENV=development && nodemon src/server/index.js --ignore src/client --exec babel-node",
    "build:front": "webpack -p --config webpack.production.config.js",
    "build:back": "babel src/server -d dist/server",
    "build": "webpack -p --config webpack.production.config.js && babel src/server -d dist/server",
    "clear": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Denis Harchenko",
  "license": "MIT",
  "devDependencies": {
    "@material-ui/core": "^4.3.2",
    "axios": "^0.21.1",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "babel-loader": "^7.1.2",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.6.1",
    "babel-preset-react": "^6.24.1",
    "clean-webpack-plugin": "^0.1.18",
    "css-loader": "^0.28.9",
    "extract-text-webpack-plugin": "^4.0.0-beta.0",
    "image-webpack-loader": "^4.0.0",
    "node-sass": "^4.7.2",
    "redux-logger": "^3.0.6",
    "sass-loader": "^6.0.6",
    "style-loader": "^0.20.1",
    "styled-components": "^4.3.2",
    "webpack": "^4.39.2",
    "webpack-cli": "^3.3.6",
    "webpack-dev-middleware": "^2.0.4",
    "webpack-hot-middleware": "^2.21.0"
  },
  "dependencies": {
    "bluebird": "^3.5.1",
    "body-parser": "^1.18.2",
    "express": "^4.16.2",
    "mongodb": "^3.0.2",
    "mongoose": "^5.0.3",
    "morgan": "^1.9.0",
    "nodemon": "^1.14.12",
    "react": "^16.2.0",
    "react-dom": "^16.2.0",
    "react-hot-loader": "^3.1.3",
    "react-redux": "^7.1.0",
    "react-router": "^4.2.0",
    "react-router-dom": "^4.2.2",
    "react-transition-group": "^2.2.1",
    "redux": "^3.7.2"
  }
